        <mxCell id="t-title" value="织境 Story Studio · 运行时拓扑（目标流程与冻结能力）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1">
