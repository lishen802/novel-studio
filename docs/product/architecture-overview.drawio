        </mxCell>
        <mxCell id="k-pub" value="公开阶段（产品界面只认这些）&#xa;context_preparing → chapter_directing → professional_analysis → prose_writing → independent_review → bounded_revision → revision_verify → candidate_ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="k-min" value="最小质量基线 quality.chapter.v1：plan → draft → review_bundle → lint/gate → 有问题则 bounded_revision 一次。综合审阅单节点输出三类 Finding，Schema 已分 category。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="700" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="k-slot" value="slot-parallel 写作段：director → skeleton → 五类槽位写手（对话/动作/内心/描写/过渡，互不可见）→ mechanical_join → integrate → review → revision。全部映射 prose_writing。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="580" width="700" height="80" as="geometry"/>
        </mxCell>
      </root>
