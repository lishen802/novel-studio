        <mxCell id="t-e1" value="1. 命令 / 状态查询（薄 Wails DTO）" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;fontSize=11;fontColor=#57534e;" edge="1" parent="1" source="t-ui" target="t-app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-app" value="&lt;b&gt;应用编排层 Application Service&lt;/b&gt;&lt;br&gt;权威工作台投影 RunProjection / JobPublicProjection · 状态机与幂等 JobLease / JobEvent / JobSnapshot&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;internal/application/workspace · agentkernel.Service · appshell · appsettings · creativeharness&lt;/font&gt;&lt;br&gt;React 不推断阶段、候选可应用性或 stale；Wails binding 只做 DTO 转换与事件唤醒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="1440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t-e2" value="2. 上下文装配" style="endArrow=classic;html=1;rounded=0;fontSize=11;fontColor=#57534e;" edge="1" parent="1" source="t-app" target="t-ctx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-e3" value="3. 编译与调度" style="endArrow=classic;html=1;rounded=0;fontSize=11;fontColor=#57534e;" edge="1" parent="1" source="t-app" target="t-router">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-e4" value="4. 读写校验" style="endArrow=classic;html=1;rounded=0;fontSize=11;fontColor=#57534e;" edge="1" parent="1" source="t-app" target="t-store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-ctx" value="&lt;b&gt;Context Assembler&lt;/b&gt;&lt;br&gt;确定性规则筛选&lt;br&gt;预算 / Token 计算&lt;br&gt;Context Manifest&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;workspace/context_manifest.go&lt;br&gt;agentkernel 节点装配&lt;br&gt;json.assembler v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t-router" value="&lt;b&gt;Agent Kernel Router&lt;/b&gt;&lt;br&gt;动态工作流加载（不可变版本）&lt;br&gt;能力与模型槽解耦&lt;br&gt;确定性门禁 Lint / Quality Gate&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;agentkernel.Compile + Service&lt;br&gt;agentassets.Builtin 注册表&lt;br&gt;quality.Engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t-store" value="&lt;b&gt;Domain Model Store&lt;/b&gt;&lt;br&gt;SQLite WAL + Goose 迁移&lt;br&gt;.zjproject 项目包&lt;br&gt;候选与正式资产隔离&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;persistence/sqlite&lt;br&gt;ports.ProjectStore&lt;br&gt;ChangeSet / Artifact&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1100" y="370" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t-e5" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="t-router" target="t-kernel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-kernel" value="智能体能力执行内核  Agent Execution Kernel    ·    internal/application/agentkernel + domain/agent" style="swimlane;fontStyle=1;childLayout=0;horizontal=1;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1440" height="1180" as="geometry"/>
        </mxCell>
        <mxCell id="t-a-label" value="阶段 A · 导演、分析与有界补查　　公开阶段 chapter_directing / professional_analysis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#166534;" vertex="1" parent="t-kernel">
          <mxGeometry x="24" y="52" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t-director" value="&lt;b&gt;Chapter Director&lt;/b&gt;&lt;br&gt;能力 chapter_planner · 槽 planner&lt;br&gt;把路线图与冻结 Manifest 转成可执行叙事任务&lt;br&gt;chapter_goal / scenes / anchors / forbidden_reveals / improvisation_bounds&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;节点 director · Prompt chapter_plan.prompt v2 · Schema chapter_plan.schema v2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="84" width="640" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-analysis" value="&lt;b&gt;Specialized State Analysis&lt;/b&gt;&lt;br&gt;连续性 / 人物动机与知识边界 / 伏笔与叙事债务 / 世界规则&lt;br&gt;只输出 ConstraintNote 与风险，不拼写正文&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#b45309&quot;&gt;协议已落地（ConstraintNotesOutput）；默认导演工作流尚未插入独立节点，Harness 可加变体&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;align=center;dashed=1;" vertex="1" parent="t-kernel">
          <mxGeometry x="740" y="84" width="660" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-ea" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-director" target="t-analysis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-eb" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-analysis" target="t-writer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-b-label" value="阶段 B · 正文生成　　公开阶段 prose_writing　　默认单一主写，拒绝多模型拼接成章" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#166534;" vertex="1" parent="t-kernel">
          <mxGeometry x="24" y="214" width="900" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t-writer" value="&lt;b&gt;Prose Writer&lt;/b&gt;　能力 prose_writer · 槽 writer&lt;br&gt;只读任务、冻结上下文与导演产物，不读审阅标准答案或其它模型隐藏推理&lt;br&gt;输出 ChapterDraftOutput.body　·　节点 draft　·　Prompt prose_writer.prompt v1&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;实验变体 slot-parallel：skeleton_writer → 五类 slot_writer（互不可见）→ 确定性拼接 mechanical_join → integration_writer 缝合；仍映射同一公开阶段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="244" width="1360" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t-ec" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-writer" target="t-cont">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-c-label" value="阶段 C · 隔离审阅、合并与按需核验　　公开阶段 independent_review　　审阅者互不读取结论" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#166534;" vertex="1" parent="t-kernel">
          <mxGeometry x="24" y="360" width="1000" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t-cont" value="&lt;b&gt;Continuity Review&lt;/b&gt;&lt;br&gt;continuity_review&lt;br&gt;事实 / 状态 / 知识边界 / 时间线 / 伏笔&lt;br&gt;槽 continuity_reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="392" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-content" value="&lt;b&gt;Content Review&lt;/b&gt;&lt;br&gt;content_review&lt;br&gt;节奏 / 因果 / 动机 / 钩子 / 信息密度&lt;br&gt;槽 continuity_reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="520" y="392" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-style" value="&lt;b&gt;Style Review&lt;/b&gt;&lt;br&gt;style_review&lt;br&gt;重复 / 套话 / 机械排比 / 总结腔&lt;br&gt;槽 continuity_reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="1000" y="392" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-ed1" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-cont" target="t-merger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-ed2" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-content" target="t-merger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-ed3" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-style" target="t-merger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-merger" value="&lt;b&gt;Finding Merger&lt;/b&gt;　确定性应用组件，不调用模型&lt;br&gt;规范化 / 精确去重 / 稳定排序 / 关联证据 / 标注同证据冲突　·　不得补写问题或降低严重度&lt;br&gt;agentdomain.MergeFindings　·　工作流 quality.chapter.split-review 三审阅节点并行输入修订" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;fontStyle=0;" vertex="1" parent="t-kernel">
          <mxGeometry x="280" y="540" width="880" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="t-ee" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="t-kernel" source="t-merger" target="t-rev">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-lint" value="&lt;b&gt;Deterministic Lint + Quality Gate&lt;/b&gt;&lt;br&gt;quality.Engine　·　锚点 / 禁止项 / 字数 / 重复 / 机械句式 / 元话语&lt;br&gt;质量状态 passed / needs_review / blocked　≠ AgentRun 终态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="540" width="220" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="t-d-label" value="阶段 D · 有界修订、复检与选稿　　公开阶段 bounded_revision / revision_verify" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#166534;" vertex="1" parent="t-kernel">
          <mxGeometry x="24" y="650" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t-rev" value="&lt;b&gt;Bounded Revision&lt;/b&gt;　能力 bounded_revision　·　正文默认槽 writer，方案用 planner&lt;br&gt;只接收规范化公开发现或作者指令（RevisionDirective），不接收其它模型隐藏推理&lt;br&gt;quality_findings 与 author_directed 分模式；自动修订最多一次；只改未定稿候选并保留上一 attempt&lt;br&gt;v2 已有独立复核；R5 新版本每稿复检，退化可选有效前稿，预算到限暂停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="682" width="1360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t-wf" value="已发布工作流（internal/agentassets）&#xa;baseline.chapter.v1　|　quality.chapter.v1/v2　|　quality.blueprint.v1/v2　|　quality.chapter.director.v1/v2　|　quality.chapter.split-review.v1/v2　|　quality.chapter.slot-parallel.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=11;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="814" width="1360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="t-slots" value="兼容模型槽（R2.1，不是 Agent 数量）　planner / writer / continuity_reviewer　·　CapabilityResolver 把能力映射到槽，再解析项目锁定的 CreativeProfileVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=11;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="886" width="1360" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="t-provider" value="Provider Runtime　OpenAI 兼容 / Anthropic　·　internal/providers　·　密钥只在节点执行时按冻结凭据引用从 OS 凭据库读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=11;align=center;" vertex="1" parent="t-kernel">
          <mxGeometry x="40" y="950" width="1360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t-e6" value="5. 校验 &amp; 流式返回（未确认候选）" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;fontSize=11;fontColor=#57534e;" edge="1" parent="1" source="t-kernel" target="t-cand">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-cand" value="&lt;b&gt;Candidate Buffer 未确认候选区&lt;/b&gt;&lt;br&gt;DraftCandidate / Artifact / ChangeSet　·　确认后原子写 Canonical Head，再异步核验记忆&lt;br&gt;R3 只写 Harness 工件或未确认候选，不写 canonical 正文和正式资产　·　同批前序候选只能 provisional 进入后序上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1810" width="1440" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
