        </mxCell>
        <mxCell id="t-note" value="权威规格：docs/product/architecture.md。当前 R4 待验收；R5 补查/核验/复检与最小后验，R6 批次/弧评估，R7 长篇扩展。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="80" y="48" width="900" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t-ui" value="&lt;b&gt;React UI&lt;/b&gt;&lt;br&gt;创作驾驶舱 / 正文工作台 / 审阅与候选 / Lab 观察器&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#57534e&quot;&gt;apps/desktop/frontend · Cockpit · Chapters · Review · Lab · Archive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;" vertex="1" parent="1">
