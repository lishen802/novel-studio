{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["characters", "relationships", "factions", "locations", "world_rules", "forbidden", "omission_reasons"],
  "properties": {
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "aliases", "summary", "motivation", "arc"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["protagonist", "supporting", "antagonist", "minor"] },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "summary": { "type": "string", "minLength": 1 },
          "motivation": { "type": "string", "minLength": 1 },
          "fear": { "type": "string" },
          "secret": { "type": "string" },
          "arc": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_name", "target_name", "kind", "label", "strength"],
        "properties": {
          "source_name": { "type": "string", "minLength": 1 },
          "target_name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["ally", "family", "romantic", "rival", "enemy", "mentor", "other"] },
          "label": { "type": "string" },
          "strength": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "factions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "summary", "goal"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 }
        }
      }
    },
    "locations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["city", "settlement", "building", "landmark", "wilderness", "other"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "world_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "scope_type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "scope_type": { "enum": ["project", "region", "location"] }
        }
      }
    },
    "forbidden": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "omission_reasons": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } }
  }
}
