{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title", "positioning", "core_conflict", "protagonist_arc", "world_rules", "major_milestones",
    "sell_point", "genre", "growth_cost", "pacing", "ending", "subplots", "forbidden", "anchors"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "positioning": { "type": "string", "minLength": 1 },
    "core_conflict": { "type": "string", "minLength": 1 },
    "protagonist_arc": { "type": "string", "minLength": 1 },
    "world_rules": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "major_milestones": { "type": "array", "minItems": 3, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sell_point": { "type": "string", "minLength": 1 },
    "genre": { "type": "string", "minLength": 1 },
    "growth_cost": { "type": "string", "minLength": 1 },
    "pacing": { "type": "string", "minLength": 1 },
    "ending": { "type": "string", "minLength": 1 },
    "subplots": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "forbidden": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "anchors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strength", "statement"],
        "properties": {
          "strength": { "enum": ["hard", "soft", "forbidden"] },
          "statement": { "type": "string", "minLength": 1 },
          "scope_hint": { "type": "string" }
        }
      }
    }
  }
}
