{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "verdicts", "regressions"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "verified_status", "rationale"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "verified_status": { "enum": ["open", "resolved", "retained", "cannot_resolve"] },
          "rationale": { "type": "string", "minLength": 1 },
          "quote": { "type": "string" },
          "scope_start": { "type": "integer", "minimum": 0 },
          "scope_end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "regressions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "status", "source", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "anchor",
              "continuity",
              "knowledge_boundary",
              "causality",
              "motivation",
              "pacing",
              "hook",
              "information_density",
              "world_rule",
              "foreshadowing",
              "repetition",
              "style",
              "format",
              "originality_risk"
            ]
          },
          "severity": { "enum": ["blocker", "major", "minor", "note"] },
          "status": { "enum": ["open"] },
          "source": { "enum": ["model_review"] },
          "message": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" },
          "quote": { "type": "string" },
          "scope_start": { "type": "integer", "minimum": 0 },
          "scope_end": { "type": "integer", "minimum": 1 },
          "constraint_ref": { "type": "string" }
        }
      }
    }
  }
}
