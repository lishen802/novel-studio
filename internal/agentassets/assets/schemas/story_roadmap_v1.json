{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["book", "volumes", "arcs", "near_term_chapters"],
  "properties": {
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "proposition", "ending", "protagonist_arc", "inviolable"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "proposition": { "type": "string", "minLength": 1 },
        "ending": { "type": "string", "minLength": 1 },
        "protagonist_arc": { "type": "string", "minLength": 1 },
        "inviolable": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "goal", "conflict", "payoff", "position"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "conflict": { "type": "string", "minLength": 1 },
          "payoff": { "type": "string", "minLength": 1 },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "arcs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["volume_ref", "title", "causal_chain", "character_change", "foreshadowing", "position"],
        "properties": {
          "volume_ref": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "causal_chain": { "type": "string", "minLength": 1 },
          "character_change": { "type": "string", "minLength": 1 },
          "foreshadowing": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "near_term_chapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "goal", "conflict", "outcome", "anchors", "position"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "conflict": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "anchors": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
