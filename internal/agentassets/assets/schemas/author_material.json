{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "source_hash",
    "proposal",
    "people_world",
    "roadmap",
    "gaps",
    "field_sources"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "proposal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "positioning",
            "core_conflict",
            "protagonist_arc",
            "world_rules",
            "major_milestones",
            "sell_point",
            "genre",
            "growth_cost",
            "pacing",
            "ending",
            "subplots",
            "forbidden",
            "anchors"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "positioning": {
              "type": "string",
              "minLength": 1
            },
            "core_conflict": {
              "type": "string",
              "minLength": 1
            },
            "protagonist_arc": {
              "type": "string",
              "minLength": 1
            },
            "world_rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "major_milestones": {
              "type": "array",
              "minItems": 3,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sell_point": {
              "type": "string",
              "minLength": 1
            },
            "genre": {
              "type": "string",
              "minLength": 1
            },
            "growth_cost": {
              "type": "string",
              "minLength": 1
            },
            "pacing": {
              "type": "string",
              "minLength": 1
            },
            "ending": {
              "type": "string",
              "minLength": 1
            },
            "subplots": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "anchors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "strength",
                  "statement"
                ],
                "properties": {
                  "strength": {
                    "enum": [
                      "hard",
                      "soft",
                      "forbidden"
                    ]
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope_hint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "people_world": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "characters",
            "relationships",
            "factions",
            "locations",
            "world_rules",
            "forbidden",
            "omission_reasons"
          ],
          "properties": {
            "characters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "role",
                  "aliases",
                  "summary",
                  "motivation",
                  "arc"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "protagonist",
                      "supporting",
                      "antagonist",
                      "minor"
                    ]
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "motivation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fear": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "string"
                  },
                  "arc": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "relationships": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "source_character_ref",
                  "target_character_ref",
                  "kind",
                  "label",
                  "strength"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_character_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_character_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "ally",
                      "family",
                      "romantic",
                      "rival",
                      "enemy",
                      "mentor",
                      "other"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "strength": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  }
                }
              }
            },
            "factions": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "summary",
                  "goal"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "locations": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind",
                  "summary"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "city",
                      "settlement",
                      "building",
                      "landmark",
                      "wilderness",
                      "other"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "world_rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "description",
                  "scope_type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope_type": {
                    "enum": [
                      "project",
                      "region",
                      "location"
                    ]
                  }
                }
              }
            },
            "forbidden": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "omission_reasons": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "roadmap": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "book",
            "volumes",
            "arcs",
            "near_term_chapters"
          ],
          "properties": {
            "book": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "proposition",
                "ending",
                "protagonist_arc",
                "inviolable"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition": {
                  "type": "string",
                  "minLength": 1
                },
                "ending": {
                  "type": "string",
                  "minLength": 1
                },
                "protagonist_arc": {
                  "type": "string",
                  "minLength": 1
                },
                "inviolable": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "volumes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "goal",
                  "conflict",
                  "payoff",
                  "position"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conflict": {
                    "type": "string",
                    "minLength": 1
                  },
                  "payoff": {
                    "type": "string",
                    "minLength": 1
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "arcs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "volume_ref",
                  "title",
                  "causal_chain",
                  "character_change",
                  "foreshadowing",
                  "position",
                  "reader_expectation",
                  "stage_payoff",
                  "irreversible_change",
                  "ending_contribution",
                  "commitments",
                  "retained_questions"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "volume_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "causal_chain": {
                    "type": "string",
                    "minLength": 1
                  },
                  "character_change": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reader_expectation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stage_payoff": {
                    "type": "string",
                    "minLength": 1
                  },
                  "irreversible_change": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ending_contribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commitments": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "statement",
                        "fulfillment_range",
                        "related_refs"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "statement": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fulfillment_range": {
                          "type": "string",
                          "minLength": 1
                        },
                        "related_refs": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "commitments_omission": {
                    "type": "string"
                  },
                  "retained_questions": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "statement",
                        "reason"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "statement": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "retained_questions_omission": {
                    "type": "string"
                  },
                  "foreshadowing": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "near_term_chapters": {
              "type": "array",
              "minItems": 3,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "arc_ref",
                  "title",
                  "goal",
                  "conflict",
                  "outcome",
                  "anchors",
                  "position"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arc_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conflict": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anchors": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "strength",
                        "statement"
                      ],
                      "properties": {
                        "strength": {
                          "enum": [
                            "hard",
                            "soft",
                            "forbidden"
                          ]
                        },
                        "statement": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "gaps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "field_path",
          "kind",
          "reason",
          "quote",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "proposal",
              "people_world",
              "roadmap"
            ]
          },
          "field_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "required",
              "optional",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "field_sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "field_path",
          "quote"
        ],
        "properties": {
          "stage": {
            "enum": [
              "proposal",
              "people_world",
              "roadmap"
            ]
          },
          "field_path": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
