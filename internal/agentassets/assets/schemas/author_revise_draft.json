{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["title", "body", "changes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "changes": {"type": "array", "minItems": 1, "maxItems": 200, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["target_ref", "original_text", "revised_text"],
      "properties": {
        "finding_id": {"type": "string", "maxLength": 0},
        "target_ref": {"type": "string", "minLength": 1},
        "original_text": {"type": "string", "minLength": 1},
        "revised_text": {"type": "string", "minLength": 1}
      }
    }},
    "resolutions": {"type": "array", "maxItems": 0}
  }
}
