{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_goal", "opening_hook", "ending_hook", "scenes"],
  "properties": {
    "chapter_goal": { "type": "string", "minLength": 1 },
    "opening_hook": { "type": "string", "minLength": 1 },
    "ending_hook": { "type": "string", "minLength": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "conflict", "outcome"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "conflict": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
