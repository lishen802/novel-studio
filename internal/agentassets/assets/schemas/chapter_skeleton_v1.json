{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_goal", "beats"],
  "properties": {
    "chapter_goal": {"type": "string", "minLength": 1},
    "beats": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["beat_id", "summary", "pov", "slots"],
        "properties": {
          "beat_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "pov": {"type": "string", "minLength": 1},
          "slots": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["slot_id", "slot_type", "intent", "constraints", "target_runes", "source_refs"],
              "properties": {
                "slot_id": {"type": "string", "minLength": 1},
                "slot_type": {"enum": ["dialogue", "action", "interiority", "description", "transition"]},
                "intent": {"type": "string", "minLength": 1},
                "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "target_runes": {"type": "integer", "minimum": 1},
                "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
