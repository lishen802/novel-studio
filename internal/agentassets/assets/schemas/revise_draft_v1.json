{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "body", "resolutions", "changes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "status", "note"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["resolved", "retained", "cannot_resolve"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "original_text", "revised_text"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "original_text": { "type": "string", "minLength": 1 },
          "revised_text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
